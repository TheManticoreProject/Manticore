 typedef struct _PROTOCOLCOUNTERS {
     ULONG WdBytes;             
     ULONG WdFrames;            
     ULONG WaitForOutBuf;       
     ULONG Frames;              
     ULONG Bytes;               
     ULONG CompressedBytes;     
     ULONG CompressFlushes;     
     ULONG Errors;              
     ULONG Timeouts;            
     ULONG AsyncFramingError;   
